# CRM Data Agent Environment Configuration
# Copy this file to src/.env and update with your actual values

# ============================================================================
# REQUIRED CONFIGURATION - These must be set for the application to work
# ============================================================================

# Agent Configuration
AGENT_NAME="crm_data_agent"
GOOGLE_GENAI_USE_VERTEXAI=1

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="asia-south1"

# Cloud Storage for ADK artifacts and Vertex AI assets
AI_STORAGE_BUCKET="your-ai-storage-bucket"

# BigQuery Configuration
BQ_LOCATION="US"
SFDC_BQ_DATASET="sfdc_data"

# Firestore Configuration for session storage
FIRESTORE_SESSION_DATABASE="(default)"

# Salesforce Metadata Configuration
SFDC_METADATA_FILE="sfdc_metadata.json"

# ============================================================================
# OPTIONAL CONFIGURATION - These have defaults or are derived from above
# ============================================================================

# BigQuery Project (defaults to GOOGLE_CLOUD_PROJECT if not set)
# BQ_PROJECT_ID="your-bigquery-project-id"

# Salesforce Data Project (defaults to BQ_PROJECT_ID if not set)
# SFDC_DATA_PROJECT_ID="your-salesforce-data-project-id"

# ============================================================================
# AUTHENTICATION - Set this for local development
# ============================================================================

# Path to your Google Cloud service account key file
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"

# Google API Key (if needed for specific features)
# GOOGLE_API_KEY="your-google-api-key"

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. Copy this file to src/.env
# 2. Replace all placeholder values with your actual configuration
# 3. Ensure your service account has these roles:
#    - Cloud Datastore User (for Firestore)
#    - BigQuery Data Viewer (for Salesforce data)
#    - BigQuery Job User (for running queries)
#    - Vertex AI User (for Gemini model access)
#    - Storage Object User (for AI storage bucket)
# 4. Place your service account key file in the project root
# 5. Run ./scripts/setup_env.sh to verify configuration

# ============================================================================
# EXAMPLE VALUES
# ============================================================================

# GOOGLE_CLOUD_PROJECT="my-crm-project-123456"
# GOOGLE_CLOUD_LOCATION="us-central1"
# AI_STORAGE_BUCKET="my-crm-agent-assets"
# FIRESTORE_SESSION_DATABASE="(default)"
# GOOGLE_APPLICATION_CREDENTIALS="/Users/myuser/my-project/service-account-key.json"